DATABASE_URL="file:./dev.db"

# Required for the /train and /coach chat features
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: defaults to claude-sonnet-4-5
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Optional: comma-separated allowlist of origins allowed to call
# POST /api/coach/chat directly from a browser (e.g. an embedded
# coaching site). Defaults to "*" (all origins) if unset — lock this
# down before going to production.
COACH_API_ALLOWED_ORIGIN="https://your-coaching-site.com"
